# ==============================================================================
# Dawaee Pharmacy Platform - Environment Variables Template
# Copy this file to .env and fill in your secure credentials before running.
# NEVER commit the actual .env file to version control!
# ==============================================================================

# Node Environment ('development' | 'production')
NODE_ENV="development"

# Server Port
PORT=4000

# PostgreSQL Multi-Tenant Database Connection URL
DATABASE_URL="postgresql://user:password@host:5432/dawaee_db?schema=public"

# JWT Authentication Secret (Required in production: minimum 32 characters)
# Generate with: openssl rand -hex 32
JWT_SECRET="GENERATE_A_STRONG_RANDOM_SECRET_FOR_PRODUCTION_MIN_32_CHARS"
JWT_EXPIRES_IN="7d"

# Super Admin Dashboard Credentials
# (Mandatory in production: choose a strong username and complex password)
ADMIN_USERNAME="admin_secure_user"
ADMIN_PASSWORD="CHOOSE_A_STRONG_PASSWORD_MIN_12_CHARS_NOT_DEFAULT"

# Optional Cloudflare R2 / S3 Master Backup Storage Credentials
# R2_BUCKET_NAME="dawaee-backups"
# R2_ACCOUNT_ID="your-cloudflare-account-id"
# R2_ACCESS_KEY_ID="your-r2-access-key-id"
# R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"

# Optional Google Gemini AI Key (for Smart Invoice Scanner)
# GEMINI_API_KEY="your-google-gemini-api-key"

