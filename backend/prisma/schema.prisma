// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. MASTER DB MODELS (Public Schema)
// ==========================================

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
}

model Tenant {
  id                 String             @id @default(uuid()) @db.Uuid
  name               String             @db.VarChar(255)
  slug               String             @unique @db.VarChar(100)
  schemaName         String             @unique @map("schema_name") @db.VarChar(100)
  governorate        String             @db.VarChar(100)
  district           String             @db.VarChar(100)
  addressDetails     String?            @map("address_details") @db.Text
  googleMapsUrl      String?            @map("google_maps_url") @db.Text
  latitude           Decimal?           @db.Decimal(10, 8)
  longitude          Decimal?           @db.Decimal(11, 8)
  phone              String             @db.VarChar(50)
  logoUrl            String?            @map("logo_url") @db.Text
  receiptHeader      String?            @map("receipt_header") @db.Text
  receiptFooter      String?            @map("receipt_footer") @db.Text
  licenseKey         String             @unique @map("license_key") @db.VarChar(255)
  subscriptionStatus SubscriptionStatus @default(ACTIVE) @map("subscription_status")
  subscriptionEndsAt DateTime           @map("subscription_ends_at")
  lastBackupAt       DateTime?          @map("last_backup_at")
  backupStatus       String?            @default("PENDING") @map("backup_status") @db.VarChar(50)
  r2BucketName       String?            @map("r2_bucket_name") @db.VarChar(255)
  r2AccountId        String?            @map("r2_account_id") @db.VarChar(255)
  r2AccessKeyId      String?            @map("r2_access_key_id") @db.VarChar(255)
  r2SecretAccessKey  String?            @map("r2_secret_access_key") @db.Text
  isSearchVisible    Boolean            @default(true) @map("is_search_visible")
  showSellingPrices  Boolean            @default(true) @map("show_selling_prices")
  showPhoneNumber    Boolean            @default(true) @map("show_phone_number")
  showWhatsapp       Boolean            @default(true) @map("show_whatsapp")
  is24Hours          Boolean            @default(false) @map("is_24_hours")
  geminiApiKey       String?            @map("gemini_api_key") @db.Text
  chainId            String?            @map("chain_id") @db.Uuid
  chainRole          String?            @default("BRANCH") @map("chain_role") @db.VarChar(50)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  chain              PharmacyChain?     @relation(fields: [chainId], references: [id], onDelete: SetNull)
  searchIndexes      CentralSearchIndex[]

  @@map("tenants")
}

model PharmacyChain {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(255)
  ownerName   String?  @map("owner_name") @db.VarChar(255)
  ownerPhone  String?  @map("owner_phone") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenants     Tenant[]
  transfers   StockTransfer[]

  @@map("pharmacy_chains")
}

model StockTransfer {
  id                 String    @id @default(uuid()) @db.Uuid
  transferNumber     String    @unique @map("transfer_number") @db.VarChar(100)
  chainId            String    @map("chain_id") @db.Uuid
  sourceTenantId     String    @map("source_tenant_id") @db.Uuid
  targetTenantId     String    @map("target_tenant_id") @db.Uuid
  sourcePharmacyName String    @map("source_pharmacy_name") @db.VarChar(255)
  targetPharmacyName String    @map("target_pharmacy_name") @db.VarChar(255)
  medicineId         String    @map("medicine_id") @db.Uuid
  tradeName          String    @map("trade_name") @db.VarChar(255)
  batchNumber        String?   @map("batch_number") @db.VarChar(100)
  expiryDate         DateTime? @map("expiry_date")
  quantityPacks      Int       @map("quantity_packs")
  quantityUnits      Int       @map("quantity_units")
  purchasePricePack  Decimal   @map("purchase_price_pack") @db.Decimal(12, 2)
  status             String    @default("PENDING") @map("status") @db.VarChar(50)
  notes              String?   @db.Text
  batchAllocations   Json?     @map("batch_allocations")
  senderUserName     String?   @map("sender_user_name") @db.VarChar(100)
  receiverUserName   String?   @map("receiver_user_name") @db.VarChar(100)
  createdAt          DateTime  @default(now()) @map("created_at")
  completedAt        DateTime? @map("completed_at")

  chain              PharmacyChain @relation(fields: [chainId], references: [id], onDelete: Cascade)

  @@index([chainId])
  @@index([sourceTenantId])
  @@index([targetTenantId])
  @@map("stock_transfers")
}

model Medicine {
  id                     String   @id @default(uuid()) @db.Uuid
  tradeName              String   @map("trade_name") @db.VarChar(255)
  scientificName         String?  @map("scientific_name") @db.VarChar(255)
  dosageForm             String?  @map("dosage_form") @db.VarChar(100)
  strength               String?  @db.VarChar(100)
  manufacturer           String?  @db.VarChar(255)
  barcode                String?  @db.VarChar(100)
  defaultUnitsPerPack    Int      @default(1) @map("default_units_per_pack")
  defaultPurchasePrice   Decimal? @default(0) @map("default_purchase_price") @db.Decimal(12, 2)
  needsStrengthReview    Boolean  @default(false) @map("needs_strength_review")
  needsFormReview        Boolean  @default(false) @map("needs_form_review")
  needsPackagingReview   Boolean  @default(true) @map("needs_packaging_review")
  isVerified             Boolean  @default(true) @map("is_verified")
  createdAt              DateTime @default(now()) @map("created_at")

  searchIndexes CentralSearchIndex[]

  @@index([barcode])
  @@index([tradeName])
  @@index([scientificName])
  @@map("medicines")
}

model CentralSearchIndex {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  medicineId        String   @map("medicine_id") @db.Uuid
  pharmacyName      String   @map("pharmacy_name") @db.VarChar(255)
  governorate       String   @db.VarChar(100)
  district          String   @db.VarChar(100)
  addressDetails    String?  @map("address_details") @db.Text
  googleMapsUrl     String?  @map("google_maps_url") @db.Text
  latitude          Decimal? @db.Decimal(10, 8)
  longitude         Decimal? @db.Decimal(11, 8)
  phone             String   @db.VarChar(50)
  tradeName         String   @map("trade_name") @db.VarChar(255)
  scientificName    String?  @map("scientific_name") @db.VarChar(255)
  dosageForm        String?  @map("dosage_form") @db.VarChar(100)
  strength          String?  @db.VarChar(100)
  sellingPricePack  Decimal  @map("selling_price_pack") @db.Decimal(12, 2)
  stockStatus       String   @default("HIGH_STOCK") @map("stock_status") @db.VarChar(50)
  showSellingPrices Boolean  @default(true) @map("show_selling_prices")
  showPhoneNumber   Boolean  @default(true) @map("show_phone_number")
  showWhatsapp      Boolean  @default(true) @map("show_whatsapp")
  is24Hours         Boolean  @default(false) @map("is_24_hours")
  isAvailable       Boolean  @default(true) @map("is_available")
  lastSyncedAt      DateTime @default(now()) @map("last_synced_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@unique([tenantId, medicineId])
  @@index([governorate, district])
  @@index([tradeName])
  @@index([scientificName])
  @@map("central_search_index")
}

model SystemSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ==========================================
// 2. TENANT DB MODELS (Per Pharmacy Schema)
// ==========================================

enum UserRole {
  OWNER
  CASHIER
}

enum UnitType {
  PACK
  STRIP
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(255)
  username     String    @unique @db.VarChar(100)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         UserRole  @default(CASHIER)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")

  sales   Sale[]
  returns Return[]

  @@map("users")
}

model InventoryItem {
  id               String   @id @default(uuid()) @db.Uuid
  medicineId       String   @map("medicine_id") @db.Uuid
  unitsPerPack     Int      @default(1) @map("units_per_pack")
  sellingPricePack Decimal  @map("selling_price_pack") @db.Decimal(12, 2)
  sellingPriceUnit Decimal  @map("selling_price_unit") @db.Decimal(12, 2)
  minAlertUnits    Int      @default(5) @map("min_alert_units")
  isPublicVisible  Boolean  @default(true) @map("is_public_visible")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  batches   InventoryBatch[]
  saleItems SaleItem[]
  returns   Return[]

  @@index([medicineId])
  @@map("inventory_items")
}

model InventoryBatch {
  id                    String   @id @default(uuid()) @db.Uuid
  inventoryItemId       String   @map("inventory_item_id") @db.Uuid
  batchNumber           String?  @map("batch_number") @db.VarChar(100)
  purchasePricePack     Decimal  @map("purchase_price_pack") @db.Decimal(12, 2)
  quantityUnitsRemaining Int     @map("quantity_units_remaining")
  expiryDate            DateTime @map("expiry_date") @db.Date
  createdAt             DateTime @default(now()) @map("created_at")

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  saleItems     SaleItem[]

  @@index([expiryDate])
  @@map("inventory_batches")
}

model Sale {
  id             String   @id @default(uuid()) @db.Uuid
  invoiceNumber  String   @unique @map("invoice_number") @db.VarChar(50)
  userId         String   @map("user_id") @db.Uuid
  subtotal       Decimal  @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount    Decimal  @map("total_amount") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [id])
  saleItems SaleItem[]
  returns   Return[]

  @@index([createdAt])
  @@map("sales")
}

model SaleItem {
  id               String   @id @default(uuid()) @db.Uuid
  saleId           String   @map("sale_id") @db.Uuid
  inventoryItemId  String   @map("inventory_item_id") @db.Uuid
  inventoryBatchId String?  @map("inventory_batch_id") @db.Uuid
  unitType         UnitType @map("unit_type")
  quantity         Int
  unitPrice        Decimal  @map("unit_price") @db.Decimal(12, 2)
  totalPrice       Decimal  @map("total_price") @db.Decimal(12, 2)

  sale           Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  inventoryItem  InventoryItem   @relation(fields: [inventoryItemId], references: [id])
  inventoryBatch InventoryBatch? @relation(fields: [inventoryBatchId], references: [id])

  @@map("sale_items")
}

model Return {
  id              String   @id @default(uuid()) @db.Uuid
  saleId          String?  @map("sale_id") @db.Uuid
  inventoryItemId String   @map("inventory_item_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  unitType        UnitType @map("unit_type")
  quantity        Int
  refundAmount    Decimal  @map("refund_amount") @db.Decimal(12, 2)
  reason          String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  sale          Sale?         @relation(fields: [saleId], references: [id])
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  user          User          @relation(fields: [userId], references: [id])

  @@map("returns")
}

enum ExpenseCategory {
  RENT
  SALARIES
  ELECTRICITY
  MAINTENANCE
  SUPPLIES
  TAXES
  OTHER
}

model Expense {
  id          String          @id @default(uuid()) @db.Uuid
  category    ExpenseCategory @default(OTHER)
  title       String          @db.VarChar(255)
  amount      Decimal         @db.Decimal(12, 2)
  expenseDate DateTime        @default(now()) @map("expense_date") @db.Date
  recipient   String?         @db.VarChar(255)
  notes       String?         @db.Text
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([expenseDate])
  @@map("expenses")
}

model PurchaseInvoice {
  id              String    @id @default(uuid()) @db.Uuid
  invoiceNumber   String    @map("invoice_number") @db.VarChar(100)
  supplierId      String?   @map("supplier_id") @db.Uuid
  supplierName    String?   @map("supplier_name") @db.VarChar(255)
  invoiceDate     DateTime  @default(now()) @map("invoice_date") @db.Date
  totalAmount     Decimal   @map("total_amount") @db.Decimal(12, 2)
  paidAmount      Decimal   @default(0) @map("paid_amount") @db.Decimal(12, 2)
  remainingAmount Decimal   @default(0) @map("remaining_amount") @db.Decimal(12, 2)
  notes           String?   @db.Text
  itemsCount      Int       @default(0) @map("items_count")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  items           PurchaseInvoiceItem[]

  @@map("purchase_invoices")
}

model PurchaseInvoiceItem {
  id                String   @id @default(uuid()) @db.Uuid
  purchaseInvoiceId String   @map("purchase_invoice_id") @db.Uuid
  medicineId        String   @map("medicine_id") @db.Uuid
  tradeName         String   @map("trade_name") @db.VarChar(255)
  scientificName    String?  @map("scientific_name") @db.VarChar(255)
  batchNumber       String?  @map("batch_number") @db.VarChar(100)
  expiryDate        DateTime @map("expiry_date") @db.Date
  quantityPacks     Int      @map("quantity_packs")
  unitsPerPack      Int      @default(1) @map("units_per_pack")
  purchasePricePack Decimal  @map("purchase_price_pack") @db.Decimal(12, 2)
  sellingPricePack  Decimal  @map("selling_price_pack") @db.Decimal(12, 2)
  totalCost         Decimal  @map("total_cost") @db.Decimal(12, 2)

  invoice           PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)

  @@map("purchase_invoice_items")
}

model ShiftLog {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  userName         String    @map("user_name") @db.VarChar(255)
  openedAt         DateTime  @default(now()) @map("opened_at")
  closedAt         DateTime? @map("closed_at")
  openingCash      Decimal   @default(0) @map("opening_cash") @db.Decimal(12, 2)
  expectedCash     Decimal   @default(0) @map("expected_cash") @db.Decimal(12, 2)
  actualCash       Decimal   @default(0) @map("actual_cash") @db.Decimal(12, 2)
  cashDifference   Decimal   @default(0) @map("cash_difference") @db.Decimal(12, 2)
  totalSalesCount  Int       @default(0) @map("total_sales_count")
  totalSalesAmount Decimal   @default(0) @map("total_sales_amount") @db.Decimal(12, 2)
  notes            String?   @db.Text
  status           String    @default("CLOSED") @db.VarChar(50)

  @@index([openedAt])
  @@map("shift_logs")
}

